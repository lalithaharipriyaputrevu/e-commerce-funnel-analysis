<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="funnel analysis.db" readonly="0" foreign_keys="0" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="1051"/><column_width id="4" width="0"/><expanded_item id="0" parent="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="user_events" custom_title="0" dock_id="1" table="4,11:mainuser_events"/><dock_state state="000000ff00000000fd0000000100000002000003360000031afc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000000003360000015c00ffffff000003360000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="user_events" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="135"/><column index="3" value="80"/><column index="4" value="132"/><column index="5" value="169"/><column index="6" value="75"/><column index="7" value="45"/><column index="8" value="69"/><column index="9" value="222"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">SELECT DISTINCT event_type
FROM user_events;
--Count of all distinct users in each event--
SELECT 
				COUNT(DISTINCT CASE WHEN event_type = 'view' THEN user_id END) AS views,
				COUNT(DISTINCT CASE WHEN event_type = 'cart' THEN user_id END) AS carts,
				COUNT(DISTINCT CASE WHEN event_type = 'purchase' THEN user_id END) AS purchases,
				COUNT(DISTINCT CASE WHEN event_type = 'remove_from_cart' THEN user_id END) AS remove_from_cart
FROM user_events;

--Funnel Conversion Rates--
WITH funnel AS (
    SELECT 
        COUNT(DISTINCT CASE WHEN event_type = 'view' THEN user_id END) AS views,
        COUNT(DISTINCT CASE WHEN event_type = 'cart' THEN user_id END) AS carts,
        COUNT(DISTINCT CASE WHEN event_type = 'purchase' THEN user_id END) AS purchases
    FROM user_events
)

SELECT 
    views,
    carts,
    purchases,
    ROUND(carts * 100.0 / views, 2) AS view_to_cart_rate,
    ROUND(purchases * 100.0 / carts, 2) AS cart_to_purchase_rate,
    ROUND(purchases * 100.0 / views, 2) AS views_to_purchase_conversion_rate
FROM funnel;

--Drop off calculation--
WITH funnel AS(
    SELECT
		COUNT(DISTINCT CASE WHEN event_type = 'view' THEN user_id END) AS views,
		COUNT(DISTINCT CASE WHEN event_type = 'cart' THEN user_id END) AS carts,
		COUNT(DISTINCT CASE WHEN event_type = 'purchase' THEN user_id END) AS purchases
    FROM user_events)

SELECT 
  views -carts AS drop_view_to_cart,
   carts -purchases AS drop_cart_to_purchase
FROM funnel;

--Top Converting Products--
SELECT product_id,
    COUNT(DISTINCT CASE WHEN event_type = 'view' THEN user_id END) AS views,
	COUNT(DISTINCT CASE WHEN event_type = 'purchase' THEN user_id END) AS purchases,
	ROUND(
	            COUNT(DISTINCT CASE WHEN event_type = 'purchase' THEN user_id END) *100.0/
				COUNT(DISTINCT CASE WHEN event_type = 'view' THEN user_id END) ,2)AS conversion_rate
FROM user_events
GROUP BY product_id
HAVING views &gt; 50
ORDER BY conversion_rate DESC;

    


</sql><current_tab id="0"/></tab_sql></sqlb_project>
