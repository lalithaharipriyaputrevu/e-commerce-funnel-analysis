\f1\b\fs36 \AppleHighlight-1 \AppleHilightClrSch-4 E- Commerce Funnel Analysis - SQL Queries\
Dataset - Cosmetic eCommerce User Behaviour
\f0\b0\fs24 \AppleHighlight0 \AppleHilightClrSch0 \
\
\
SELECT DISTINCT event_type\
FROM user_events;\

\f1\b\fs28 \AppleHighlight-1 \AppleHilightClrSch-4 --Count of all distinct users in each event\'97[QUERY 1]
\f0\b0\fs24 \AppleHighlight0 \AppleHilightClrSch0 \
SELECT \
				COUNT(DISTINCT CASE WHEN event_type = 'view' THEN user_id END) AS views,\
				COUNT(DISTINCT CASE WHEN event_type = 'cart' THEN user_id END) AS carts,\
				COUNT(DISTINCT CASE WHEN event_type = 'purchase' THEN user_id END) AS purchases,\
				COUNT(DISTINCT CASE WHEN event_type = 'remove_from_cart' THEN user_id END) AS remove_from_cart\
FROM user_events;\
\AppleHighlight-1 \AppleHilightClrSch-4 \

\f1\b\fs28 --Funnel Conversion Rates\'97[QUERY 2]
\f0\b0\fs24 \AppleHighlight0 \AppleHilightClrSch0 \
WITH funnel AS (\
    SELECT \
        COUNT(DISTINCT CASE WHEN event_type = 'view' THEN user_id END) AS views,\
        COUNT(DISTINCT CASE WHEN event_type = 'cart' THEN user_id END) AS carts,\
        COUNT(DISTINCT CASE WHEN event_type = 'purchase' THEN user_id END) AS purchases\
    FROM user_events\
)\
\
SELECT \
    views,\
    carts,\
    purchases,\
    ROUND(carts * 100.0 / views, 2) AS view_to_cart_rate,\
    ROUND(purchases * 100.0 / carts, 2) AS cart_to_purchase_rate,\
    ROUND(purchases * 100.0 / views, 2) AS views_to_purchase_conversion_rate\
FROM funnel;\
\

\f1\b\fs28 \AppleHighlight-1 \AppleHilightClrSch-4 --Drop off calculation\'97[QUERY 3]
\f0\b0\fs24 \AppleHighlight0 \AppleHilightClrSch0 \
WITH funnel AS(\
    SELECT\
		COUNT(DISTINCT CASE WHEN event_type = 'view' THEN user_id END) AS views,\
		COUNT(DISTINCT CASE WHEN event_type = 'cart' THEN user_id END) AS carts,\
		COUNT(DISTINCT CASE WHEN event_type = 'purchase' THEN user_id END) AS purchases\
    FROM user_events)\
\
SELECT \
  views -carts AS drop_view_to_cart,\
  carts -purchases AS drop_cart_to_purchase\
FROM funnel;\
\

\f1\b\fs28 \AppleHighlight-1 \AppleHilightClrSch-4 --Top Converting Products\'97[QUERY 4]
\f0\b0\fs24 \AppleHighlight0 \AppleHilightClrSch0 \
SELECT product_id,\
    COUNT(DISTINCT CASE WHEN event_type = 'view' THEN user_id END) AS views,\
    COUNT(DISTINCT CASE WHEN event_type = 'purchase' THEN user_id END) AS purchases,\
	ROUND(\
	            COUNT(DISTINCT CASE WHEN event_type = 'purchase' THEN user_id END) *100.0/\
		  COUNT(DISTINCT CASE WHEN event_type = 'view' THEN user_id END) ,2)AS conversion_rate\
FROM user_events\
GROUP BY product_id\
HAVING views > 50\
ORDER BY conversion_rate DESC;}